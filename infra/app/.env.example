# ===== otm-website app stack environment (.env) =====
# Used by infra/app/docker-compose.yml. Copy this file to .env and fill in
# values for local dev. Secrets stay in SECRETS_FOLDER, not here.

# Public subdomain + apex for Traefik routing.
# App is reachable at https://${SUBDOMAIN}.${TOPDOMAIN} when SUBDOMAIN is
# set, or at the apex https://${TOPDOMAIN} when SUBDOMAIN is left empty
# (the slug and its dot are dropped). Local dev keeps the subdomain;
# staging is served at the apex (SUBDOMAIN=, TOPDOMAIN=otownmakerspace.dk).
SUBDOMAIN=development
TOPDOMAIN=otownmakerspace.dk

# Application image reference (local docker tag; gets retagged from GHCR in CI)
IMAGE=otm-website:latest

# Path to secrets directory (cookie_store_key, stripe_key, stripe_publishable_key,
# stripe_webhook_secret, smtp_username, smtp_password, google_client_id,
# google_client_secret, google_refresh_token)
SECRETS_FOLDER=../../secrets/app

# Docker network shared with reverse-proxy
NETWORK_NAME=app_network

# Stripe membership Price ID — identifies which product/price Checkout
# charges for. Get from Stripe Dashboard → Products → choose product →
# Pricing → API ID. Format: price_1S… (NOT pk_… or sk_…; the publishable
# and secret keys live in secrets/app/, not here).
# Test-mode price for staging/dev; live-mode price for production.
STRIPE_PRICE_ID=price_stripe_price_id_key

# Cookie name; uniqueness across deployed domains avoids cross-site session bleed
SESSION_COOKIE_NAME=otm-session

# SMTP transport. No defaults — leaving these blank disables outbound mail.
#   HOST: the provider's *submission* endpoint. Gmail / Google Workspace:
#         smtp.gmail.com (NOT smtp.google.com — that's the inbound MX).
#   PORT: 587 for STARTTLS (Gmail's recommended port), 465 for SSL.
# The SMTP *username* is a secret file (secrets/app/smtp_username) — the full
# address of the login account (e.g. admin@otownmakerspace.dk). For Gmail the
# password secret (secrets/app/smtp_password) must be an APP PASSWORD, not
# the account password: enable 2-Step Verification on the Google account,
# then create one at https://myaccount.google.com/apppasswords. Normal
# passwords are rejected by Gmail SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Message identities (optional — both fall back to the smtp_username secret,
# i.e. everything from/to one mailbox).
#   MAIL_FROM:     visible sender of automated mail. MUST be added under the
#                  Gmail account's Settings → Accounts → "Send mail as"
#                  first, or Gmail silently rewrites the header back to the
#                  login address.
#   MAIL_REPLY_TO: human-answered inbox — set as Reply-To on automated mail,
#                  rendered as the contact link in email footers, and the
#                  recipient of new-member/cancellation admin notifications.
MAIL_FROM=noreply@otownmakerspace.dk
MAIL_REPLY_TO=info@otownmakerspace.dk

# Brand identity rendered into emails. Backend has sane defaults
# ("O'Town Makerspace" / "O'TOWN" / "MAKERSPACE" / wordmark-consolidated.svg);
# only set these to override per-deployment (e.g. for a different brand or
# rebrand).
#   NAME:             full display name in body copy + footer
#   WORDMARK_LEADING: dark/primary part of the text fallback wordmark
#   WORDMARK_ACCENT:  orange-coloured part of the text fallback wordmark
#   LOGO_URL:         absolute URL of the horizontal logo image rendered at the
#                     top of every email. Empty disables the image and uses
#                     the text fallback above. PNG or SVG; ~240x64 native size.
BRAND_NAME="O'Town Makerspace"
BRAND_WORDMARK_LEADING="O'TOWN"
BRAND_WORDMARK_ACCENT=MAKERSPACE
BRAND_LOGO_URL=https://otownmakerspace.dk/images/branding/logos/wordmark-consolidated.svg

# ===== Google Contacts mailing-list sync (optional) =====
# On subscription create/cancel the backend adds/removes the member in this
# Google Contacts label on the admin Gmail account (type the label into To/BCC
# in Gmail to mail everyone). Credentials are secret files (secrets/app/
# google_client_id, google_client_secret, google_refresh_token — mint the
# token with `go run ./cmd/googleauth` in api/); empty files disable the sync.
# Empty here uses the backend default label ("Makerspace Members"). Use a
# distinct label per environment so dev/staging never touch the real list.
GOOGLE_CONTACT_GROUP=

