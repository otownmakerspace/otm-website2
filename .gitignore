/.idea/modules.xml
/.idea/otm-website.iml
/.idea/vcs.xml

# Hugo (lives under frontend/ after the migration)
/frontend/docs/
/frontend/.hugo_build.lock
/frontend/resources/_gen/
/api/server
/api/local.db
/infra/app/.env
/infra/reverse-proxy/.env

# Traefik runtime state — ACME / Let's Encrypt certs (private keys!),
# rotating logs, dynamically-generated config. Never commit.
/infra/reverse-proxy/data/letsencrypt/
/infra/reverse-proxy/data/log/
/infra/reverse-proxy/data/dynamic/

# Terraform / Ansible provisioning state and secrets
# terraform.tfvars, ansible inventory, and group_vars/all.yml are committed
# encrypted via git-crypt — see .gitattributes.
/infra/provisioning/terraform/.terraform/
/infra/provisioning/terraform/*.tfstate
/infra/provisioning/terraform/*.tfstate.*
/infra/provisioning/ansible/*.retry
